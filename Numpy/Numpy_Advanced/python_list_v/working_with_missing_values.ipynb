   "source": [
    "# Working with missing values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e2cf41e1",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([ 1.,  2.,  3.,  4., nan,  6.])"
      ]
     },
     "execution_count": 1,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# np.nan\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "a = np.array([1,2,3,4,np.nan,6])\n",
    "a"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "751c2a79",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[False False False False  True False]\n",
      "[1. 2. 3. 4. 6.]\n"
     ]
    }
   ],
   "source": [
    "print(np.isnan(a))\n",
    "\n",
    "# how to remove all missing values present in the array\n",
    "\n",
    "print(a[~np.isnan(a)])"
   ]
  }
